{
  "expo": {
    "name": "WorkWave ServiceProvider",
    "slug": "workwave-serviceprovider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.workwave.serviceprovider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      "./plugins/withCoordinationHttp"
    ],
    "extra": {
      "eas": {
        "projectId": "5c4f8c99-1885-4ab3-a5d8-3054e563e660"
      }
    }
  }
}
